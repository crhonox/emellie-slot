--- a/gbp.c
+++ b/gbp.c
@@ -74,28 +74,32 @@
   gbp_allow_rumble = false;
 }
 
-// GB Player sequencing
+// GB Player sequencing. The game runs the whole exchange again every frame,
+// so the position starts over each frame (gbp_frame), as mGBA does; counting
+// round a fixed 16 let it drift whenever a frame had another number of
+// transfers, and then handshake words were read as the motor command.
 u32 gbp_transfer(u32 value) {
-  u32 ret = gbp_seq[gbp_seq_n++];
+  u32 ret = gbp_seq[gbp_seq_n];
 
   if (!gbp_allow_rumble &&
       reg[REG_PC] >= 0x08000000 && reg[REG_PC] < 0x0E000000)
     gbp_allow_rumble = true;
 
-  if (gbp_seq_n == 16) {
-    if (!gbp_allow_rumble) {
-      if (gbp_rumble) {
-        write_rumble(gbp_rumble, false);
-        gbp_rumble = false;
-      }
-      gbp_seq_n = 0;
-      return ret;
-    }
-
-    bool rumble_active = (value & 2);
+  // From the 13th word on the game sends the motor command in the low byte:
+  // 0x22 start, 0x00 stop, 0x11 hard stop (mGBA reads it so).
+  if (gbp_seq_n >= 12) {
+    bool rumble_active = gbp_allow_rumble && (value & 0x33) == 0x22;
     write_rumble(gbp_rumble, rumble_active);
     gbp_rumble = rumble_active;
-    gbp_seq_n = 0;
   }
+
+  // the words from the 13th on all answer the same, so the position stays
+  // there until the next frame, and fits gbp_get_state's 4 bits
+  if (gbp_seq_n < 15)
+    gbp_seq_n++;
   return ret;
 }
+
+void gbp_frame(void) {
+  gbp_seq_n = 0;
+}
