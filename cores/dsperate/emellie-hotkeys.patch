+// linux/input.h is not included: its BTN_* macros would rename the DS's own buttons.
+struct VolumeKeys {
+  struct Event { timeval time; unsigned short type, code; int value; };   // struct input_event
+  static constexpr unsigned kEvKey = 1, kKeyVolumeDown = 114, kKeyVolumeUp = 115, kKeyPower = 116, kKeyMax = 0x2ff;
+  std::vector<int> fds;
+  bool volume = false, power = false;
+  Uint32 power_since = 0;   // SDL_GetTicks() when POWER went down, 0 while it is up
+  void open_all() {
+    volume = std::getenv("DS_VOLUME_KEYS") != nullptr;
+    power = std::getenv("DS_POWER_OFF") != nullptr;
+    if (!volume && !power) return;
+    constexpr size_t kBits = 8 * sizeof(unsigned long);
+    for (int i = 0; i < 32; ++i) {
+      char path[32];
+      std::snprintf(path, sizeof path, "/dev/input/event%d", i);
+      const int fd = ::open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+      if (fd < 0) continue;
+      unsigned long keys[kKeyMax / kBits + 1] = {};
+      // EVIOCGBIT(EV_KEY, sizeof keys): the keys the node has
+      const bool bits = ::ioctl(fd, _IOC(_IOC_READ, 'E', 0x20 + kEvKey, sizeof keys), keys) >= 0;
+      auto has = [&](unsigned k) { return bits && ((keys[k / kBits] >> (k % kBits)) & 1); };
