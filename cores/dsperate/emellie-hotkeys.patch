+// The handheld's VOL+ and VOL-, read from every input node that has them (DS_VOLUME_KEYS set):
+// on the H700 handhelds they come from a node of their own that SDL opens no controller for.
+// linux/input.h is not included: its BTN_* macros would rename the DS's own buttons.
+struct VolumeKeys {
+  struct Event { timeval time; unsigned short type, code; int value; };   // struct input_event
+  static constexpr unsigned kEvKey = 1, kKeyVolumeDown = 114, kKeyVolumeUp = 115, kKeyMax = 0x2ff;
+  std::vector<int> fds;
+  void open_all() {
+    if (!std::getenv("DS_VOLUME_KEYS")) return;
+    constexpr size_t kBits = 8 * sizeof(unsigned long);
+    for (int i = 0; i < 32; ++i) {
+      char path[32];
+      std::snprintf(path, sizeof path, "/dev/input/event%d", i);
+      const int fd = ::open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+      if (fd < 0) continue;
+      unsigned long keys[kKeyMax / kBits + 1] = {};
+      // EVIOCGBIT(EV_KEY, sizeof keys): the keys the node has
+      const bool has = ::ioctl(fd, _IOC(_IOC_READ, 'E', 0x20 + kEvKey, sizeof keys), keys) >= 0 &&
+                       ((keys[kKeyVolumeUp / kBits] >> (kKeyVolumeUp % kBits)) & 1);
+      if (has) { fds.push_back(fd); std::fprintf(stderr, "volume keys: %s\n", path); }
+      else ::close(fd);
+    }
+  }
+  // VOL+ presses less VOL- presses since the last call, a held key's repeats counted.
+  int take() {
+    int steps = 0;
+    Event ev;
+    for (const int fd : fds)
+      while (::read(fd, &ev, sizeof ev) == static_cast<ssize_t>(sizeof ev))
+        if (ev.type == kEvKey && ev.value != 0) {
+          if (ev.code == kKeyVolumeUp) ++steps;
+          else if (ev.code == kKeyVolumeDown) --steps;
+        }
+    return steps;
+  }
+  ~VolumeKeys() { for (const int fd : fds) ::close(fd); }
+};
