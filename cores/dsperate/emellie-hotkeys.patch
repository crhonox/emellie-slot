+// padhotkeys.stylus_toggle (MENU+SELECT by default): the d-pad moves the pen
+// until pressed again, for a pad with no stick and no free shoulder to hold.
+// The pause menu keeps the d-pad while it is on.
+void test_stylus_toggle_gives_the_dpad_to_the_pen() {
+  using SB = SDL_GameControllerButton;
+  constexpr SB kRight = SDL_CONTROLLER_BUTTON_DPAD_RIGHT;
+  constexpr u32 kDpadRight = 1u << B::BTN_RIGHT;
+  const auto toggle = [](Input& in) {
+    T::pad(in, SDL_CONTROLLER_BUTTON_GUIDE, true);
+    T::tap_pad(in, SDL_CONTROLLER_BUTTON_BACK);
+    T::pad(in, SDL_CONTROLLER_BUTTON_GUIDE, false);
+  };
+  Rig r; r.set("padhotkeys.modifier", "guide").set("padhotkeys.pause", "mod").set("padhotkeys.layout_next", "mod+dpup");
+  r.set("pad.stylus_axis", "none").set("pad.stick_dpad", "none"); Input& in = r.go();
+  CHECK(!in.stylus_visible_binding());
+  toggle(in);
+  CHECK(in.take_actions().empty());                                        // no pause, no select for the game
+  CHECK(in.stylus_visible_binding() && (in.frame().buttons & (1u << B::BTN_SELECT)) == 0);
+  const int x0 = in.stylus_x();
+  CHECK(T::pad(in, kRight, true));
+  CHECK((in.frame().buttons & kDpadRight) == 0);
+  for (int i = 0; i < 8; ++i) in.update_stylus();
+  CHECK(in.stylus_x() > x0);
+  CHECK(T::pad(in, kRight, false));
+  in.set_menu_open(true);                                                  // the menu has the d-pad
+  CHECK(T::pad(in, kRight, true));
+  CHECK((in.menu_held() & kDpadRight) != 0);
+  const int x1 = in.stylus_x();
+  in.update_stylus(); CHECK(in.stylus_x() == x1);
+  CHECK(T::pad(in, kRight, false));
+  in.set_menu_open(false);
+  toggle(in);                                                              // and back to the game
+  CHECK(T::pad(in, kRight, true));
+  CHECK((in.frame().buttons & kDpadRight) == kDpadRight);
+  in.update_stylus(); CHECK(in.stylus_x() == x1);
+}
