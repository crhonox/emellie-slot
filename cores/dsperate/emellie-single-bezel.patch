+// A BMP of 32 bits a pixel (B, G, R, A), its rows either way up, as A R G B; false when it is
+// anything else.
+static bool read_bmp32(const char* path, const char* what, std::vector<u32>& out, int& ow, int& oh) {
+  std::FILE* f = std::fopen(path, "rb");
+  if (!f) { std::fprintf(stderr, "%s: no %s\n", what, path); return false; }
+  std::vector<unsigned char> b;
+  unsigned char chunk[65536];
+  for (size_t n; (n = std::fread(chunk, 1, sizeof chunk, f)) > 0;) b.insert(b.end(), chunk, chunk + n);
+  std::fclose(f);
+  const auto le = [&](size_t at, int bytes) { u32 v = 0; for (int i = bytes - 1; i >= 0; --i) v = v << 8 | b[at + i]; return v; };
+  if (b.size() < 54 || b[0] != 'B' || b[1] != 'M' || le(28, 2) != 32) { std::fprintf(stderr, "%s: %s is not a 32-bit BMP\n", what, path); return false; }
+  const u32 off = le(10, 4);
+  const int w = static_cast<int>(le(18, 4)), sh = static_cast<int>(le(22, 4));
+  const int h = sh < 0 ? -sh : sh;
+  if (w <= 0 || h <= 0 || w > 4096 || h > 4096 || off + static_cast<size_t>(w) * h * 4 > b.size()) { std::fprintf(stderr, "%s: %s is cut short\n", what, path); return false; }
+  out.resize(static_cast<size_t>(w) * h);
+  for (int y = 0; y < h; ++y) {
+    const unsigned char* row = b.data() + off + static_cast<size_t>(sh < 0 ? y : h - 1 - y) * w * 4;
+    for (int x = 0; x < w; ++x) {
+      const unsigned char* p = row + x * 4;
+      out[static_cast<size_t>(y) * w + x] = static_cast<u32>(p[3]) << 24 | p[2] << 16 | p[1] << 8 | p[0];
+    }
+  }
+  ow = w; oh = h;
+  return true;
+}
+
+void Display::load_bezel() {
+  if (const char* path = std::getenv("DS_SINGLE_BEZEL"); path && *path)
+    if (!read_bmp32(path, "bezel", bezel_, bezel_w_, bezel_h_)) bezel_.clear();
+  if (const char* path = std::getenv("DS_SINGLE_GRID"); path && *path) {
+    if (!read_bmp32(path, "grid", grid_ov_, grid_ov_w_, grid_ov_h_)) { grid_ov_.clear(); return; }
+    for (u32& p : grid_ov_) {
+      const u32 a = p >> 24;
+      const auto ch = [&](int s) { return ((p >> s & 0xFFu) * a + 127) / 255 << s; };
+      p = (255 - a) << 24 | ch(16) | ch(8) | ch(0);
+    }
+  }
+}
+
+// Where the bezel's top left goes, its window centred on the screen shown alone; false when it is
+// not to be drawn.
+bool Display::bezel_at(int& ox, int& oy) const {
+  if (bezel_.empty() || layout_.mode != Mode::Single || int_scale_ == IntScale::Off || only_screen_ >= 0) return false;
+  for (int i = 0; i < nviews_; ++i) {
+    const View& v = views_[i];
+    if (!v.direct || !v.shown) continue;
+    if (v.rect.w != 2 * static_cast<int>(SCREEN_W) || v.rect.h != 2 * static_cast<int>(SCREEN_H)) return false;
+    ox = v.rect.x + v.rect.w / 2 - bezel_w_ / 2;
+    oy = v.rect.y + v.rect.h / 2 - bezel_h_ / 2;
+    return true;
+  }
+  return false;
+}
+
+// Where the grid's top left goes: on the screen shown alone, integer scale off, seams blended
+// (not bilinear), the screen exactly the grid's size; false when it is not to be drawn.
+bool Display::grid_at(int& ox, int& oy) const {
+  if (grid_ov_.empty() || layout_.mode != Mode::Single || int_scale_ != IntScale::Off || only_screen_ >= 0) return false;
+  if (seam_blend_ == 0 || linear_ || disp_) return false;
+  for (int i = 0; i < nviews_; ++i) {
+    const View& v = views_[i];
+    if (!v.direct || !v.shown) continue;
+    if (v.rect.w != grid_ov_w_ || v.rect.h != grid_ov_h_) return false;
+    ox = v.rect.x; oy = v.rect.y;
+    return true;
+  }
+  return false;
+}
+
+// The screen scaled into grid_side_, under the grid, into the frame: one write a pixel.
+void Display::paint_grid() {
+  if (!grid_now_) return;
+  grid_now_ = false;
+  if (!frame_px_) return;
+  const int x0 = std::max(0, grid_x_), x1 = std::min(frame_w_, grid_x_ + grid_ov_w_);
+  const int y0 = std::max(0, grid_y_), y1 = std::min(frame_h_, grid_y_ + grid_ov_h_);
+  for (int y = y0; y < y1; ++y) {
+    const size_t at = static_cast<size_t>(y - grid_y_) * grid_ov_w_ - grid_x_;
+    const u32* ov = grid_ov_.data() + at;
+    const u32* game = grid_side_.data() + at;
+    u32* row = frame_px_ + static_cast<size_t>(y) * frame_pitch_;
+    for (int x = x0; x < x1; ++x) {
+      const u32 o = ov[x], ia = o >> 24, s = game[x];
+      const u32 rb = ((s & 0xFF00FFu) * ia >> 8) & 0xFF00FFu;
+      const u32 g = ((s & 0x00FF00u) * ia >> 8) & 0x00FF00u;
+      row[x] = 0xFF000000u | ((rb | g) + (o & 0xFFFFFFu));
+    }
+  }
+}
+
+// The bezel's opaque pixels inside `r`; its clear ones leave the frame as it is.
+void Display::paint_bezel(u32* px, u32 pitch, int w, int h, const SDL_Rect& r) const {
+  int ox = 0, oy = 0;
+  if (!bezel_at(ox, oy)) return;
+  const int x0 = std::max({0, r.x, ox}), x1 = std::min({w, r.x + r.w, ox + bezel_w_});
+  const int y0 = std::max({0, r.y, oy}), y1 = std::min({h, r.y + r.h, oy + bezel_h_});
+  for (int y = y0; y < y1; ++y) {
+    const u32* src = bezel_.data() + static_cast<size_t>(y - oy) * bezel_w_;
+    u32* row = px + static_cast<size_t>(y) * pitch;
+    for (int x = x0; x < x1; ++x) if (const u32 c = src[x - ox]; c >> 24) row[x] = c | 0xFF000000u;
+  }
+}
