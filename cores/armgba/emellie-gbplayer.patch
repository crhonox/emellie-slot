+	0x93, 0x6D, 0x94, 0xED, 0xB4, 0x6D, 0xD5, 0xF1, 0xF5, 0x71, 0xF6, 0xF1, 0x16, 0x72, 0x57, 0x72,
+	0x57, 0xF6, 0x78, 0x76, 0x78, 0xF6, 0x99, 0xF6, 0xB9, 0xF6, 0xD9, 0x76, 0xDA, 0xF6, 0x1B, 0x7B,
+	0x1B, 0xFB, 0x3C, 0xFB, 0x5C, 0x7B, 0x7D, 0x7B, 0x7D, 0xFF, 0x9D, 0x7F, 0xBE, 0x7F, 0xFF, 0x7F,
+	0x2D, 0x64, 0x8E, 0x64, 0x8F, 0xE8, 0xF1, 0xE8, 0x52, 0x6D, 0x73, 0x6D, 0xB4, 0xF1, 0x16, 0xF2,
+	0x37, 0x72, 0x98, 0x76, 0xFA, 0x7A, 0xFA, 0xFA, 0x5C, 0xFB, 0xBE, 0xFF, 0xDE, 0x7F, 0xFF, 0xFF,
+	0xFF, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
+};
+static const uint32_t GBP_LOGO_HASH = 0xEEDA6963;
+// The player's words in the exchange; from the 13th on it repeats the last.
+static const uint32_t GBP_TX[] = {
+	0x0000494E, 0x0000494E, 0xB6B1494E, 0xB6B1544E, 0xABB1544E, 0xABB14E45, 0xB1BA4E45,
+	0xB1BA4F44, 0xB0BB4F44, 0xB0BB8002, 0x10000010, 0x20000013, 0x30000003,
+};
+
+static uint32_t rotl32(uint32_t x, int r) {
+	return (x << r) | (x >> (32 - r));
+}
+
+// MurmurHash3 (x86, 32-bit), as mGBA's hash32, over bytes read little-endian.
+static uint32_t gbpHash(const uint8_t* data, size_t len, uint32_t seed) {
+	uint32_t h = seed;
+	size_t const blocks = len / 4;
+	for (size_t i = 0; i < blocks; ++i) {
+		const uint8_t* b = data + i * 4;
+		uint32_t k = b[0] | b[1] << 8 | b[2] << 16 | (uint32_t) b[3] << 24;
+		k *= 0xCC9E2D51;
+		k = rotl32(k, 15);
+		k *= 0x1B873593;
+		h ^= k;
+		h = rotl32(h, 13);
+		h = h * 5 + 0xE6546B64;
+	}
+	const uint8_t* tail = data + blocks * 4;
+	uint32_t k = 0;
+	switch (len & 3) {
+	case 3:
+		k ^= tail[2] << 16;
+		// fall through
+	case 2:
+		k ^= tail[1] << 8;
+		// fall through
+	case 1:
+		k ^= tail[0];
+		k *= 0xCC9E2D51;
+		k = rotl32(k, 15);
+		k *= 0x1B873593;
+		h ^= k;
+	}
+	h ^= (uint32_t) len;
+	h ^= h >> 16;
+	h *= 0x85EBCA6B;
+	h ^= h >> 13;
+	h *= 0xC2B2AE35;
+	h ^= h >> 16;
+	return h;
+}
+
+static bool gbpLogoShown(const struct GBA* gba) {
+	if (memcmp(gba->palette, GBP_LOGO_PALETTE, sizeof(GBP_LOGO_PALETTE)) != 0) {
+		return false;
+	}
+	return gbpHash(gba->vram + 0x8000, 0x4000, 0) == GBP_LOGO_HASH;
+}
+
+// Whether the player answers the port: found, and nothing else attached.
+static bool gbpOnPort(const struct GBA* gba) {
+	return gba->gbp.active && !linked(&gba->sio) && !gba->sio.rfu.attached;
+}
+
+// Once a frame, at its end: looks for the logo, and starts the exchange over.
+void sioFrameEnded(struct GBA* gba) {
+	struct GbPlayer* gbp = &gba->gbp;
+	if (linked(&gba->sio) || gba->sio.rfu.attached) {
+		return;
+	}
+	if (gbp->active) {
+		if (gbpLogoShown(gba)) {
+			gbp->keysPosted = (gbp->keysPosted + 1) % 3;
+		} else {
+			gbp->keysOverride = 0;
+		}
+		gbp->txPosition = 0;
+	} else if (!gbp->keysOverride && gbpLogoShown(gba)) {
+		gbp->active = 1;
+		gbp->keysPosted = 0;
+		gbp->keysOverride = 1;
+	}
+	if (gbp->keysOverride) {
+		// the keys the game reads in its V-blank, straight away
+		gbaSetKeys(gba, 0);
+	}
+}
+
+// The player's end of a transfer: the game's word may carry the motor command, and the player's
+// word comes back.
+static uint32_t gbpTransfer(struct GBA* gba, uint32_t rx) {
+	struct GbPlayer* gbp = &gba->gbp;
+	int position = gbp->txPosition;
+	if (position >= 12) {
+		// 0x22 start, 0x00 stop, 0x11 hard stop
+		gbp->rumble = (rx & 0x33) == 0x22;
+	}
+	if (position > 16) {
+		gbp->txPosition = 0;
+		position = 0;
+	} else if (position > 12) {
+		position = 12;
+	}
+	++gbp->txPosition;
+	return GBP_TX[position];
+}
