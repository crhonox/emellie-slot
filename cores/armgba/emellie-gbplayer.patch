+// The Game Boy Player, as mGBA emulates it (src/gba/sio/gbp.c there). A game made for it shows the
+// player's logo at boot and checks for it: the player answers by holding all four directions every
+// third frame while the logo shows, then by its side of a 32-bit normal-mode exchange the game
+// runs every frame. From the exchange's 13th word on, the game's word carries the motor command.
+// Only while nothing else is on the port: a link cable or the Wireless Adapter keeps it away.
+
+// The logo screen's palette (the first 64 background colours) and the hash of its tiles.
+static const uint8_t GBP_LOGO_PALETTE[] = {
+	0xDF, 0xFF, 0x0C, 0x64, 0x0C, 0xE4, 0x2D, 0xE4, 0x4E, 0x64, 0x4E, 0xE4, 0x6E, 0xE4, 0xAF, 0x68,
